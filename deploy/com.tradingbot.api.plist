<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: scripts/install_launchd.sh replaces __ROOT__ with the repo path. -->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.tradingbot.api</string>
    <key>ProgramArguments</key>
    <array>
        <string>__ROOT__/scripts/run_api.sh</string>
    </array>
    <key>WorkingDirectory</key><string>__ROOT__</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>10</integer>
    <key>ProcessType</key><string>Background</string>
    <key>StandardOutPath</key><string>__ROOT__/var/api.out.log</string>
    <key>StandardErrorPath</key><string>__ROOT__/var/api.err.log</string>
</dict>
</plist>
