# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Binance Futures (testnet) ---
BINANCE_PUBLIC_KEY=
BINANCE_SECRET_KEY=

# --- BitMEX (testnet) ---
BITMEX_PUBLIC_KEY=
BITMEX_SECRET_KEY=

# Use exchange testnet (paper trading). Keep "true" until strategies are validated.
USE_TESTNET=true

# --- Paths ---
DATABASE_PATH=data/tradingbot.db
MODEL_DIR=models

# --- Phone alerts (Phase 4, optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
